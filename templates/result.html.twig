{% extends "base.html.twig" %}

{% block title %}Scan Result - {{ app_name }}{% endblock %}

{% block content %}
{% if error %}
<div class="alert alert-danger" role="alert">
    <i class="fas fa-exclamation-circle me-2"></i>{{ error }}
</div>
<div class="text-center">
    <a href="{{ app_url }}/history.php" class="btn btn-primary">View History</a>
</div>
{% elseif scan %}

{% if scan.status in ['UPLOADED', 'VALIDATING', 'VALIDATED', 'QUEUED', 'PROCESSING', 'EXPLAINING'] %}
<!-- Processing State -->
<div class="row justify-content-center text-center mt-5">
    <div class="col-md-6">
        <div class="card shadow-sm">
            <div class="card-body py-5">
                <div class="spinner-border text-primary mb-3" role="status" style="width: 3rem; height: 3rem;">
                    <span class="visually-hidden">Loading...</span>
                </div>
                <h3>Analysis in Progress</h3>
                <p class="text-muted">Your scan is currently queued for ML inference (Status: <strong>{{ scan.status }}</strong>). This usually takes just a few seconds.</p>
                <div class="progress mt-4 mb-3" style="height: 10px;">
                    <div class="progress-bar progress-bar-striped progress-bar-animated" role="progressbar" style="width: {% if scan.status == 'QUEUED' %}25%{% elseif scan.status == 'PROCESSING' %}60%{% elseif scan.status == 'EXPLAINING' %}85%{% else %}10%{% endif %};"></div>
                </div>
                <button class="btn btn-outline-primary" onclick="window.location.reload();">Refresh Status</button>
                <p class="small text-muted mt-3">Auto-refreshing in <span id="countdown">5</span> seconds...</p>
            </div>
        </div>
    </div>
</div>
<script>
    let counter = 5;
    setInterval(() => {
        counter--;
        document.getElementById('countdown').innerText = counter;
        if (counter <= 0) window.location.reload();
    }, 1000);
</script>

{% elseif scan.status == 'FAILED' %}
<!-- Failed State -->
<div class="alert alert-danger" role="alert">
    <h4 class="alert-heading"><i class="fas fa-times-circle me-2"></i>Analysis Failed</h4>
    <p>Unfortunately, we encountered an error while processing your scan.</p>
    <hr>
    <p class="mb-0 text-monospace small">Error details: {{ scan.error_message|default('Unknown error during ML inference pipeline') }}</p>
</div>
<div class="text-center mt-3">
    <a href="{{ app_url }}/scan.php" class="btn btn-primary">Try Again</a>
    <a href="{{ app_url }}/history.php" class="btn btn-outline-secondary">View History</a>
</div>

{% else %}

<!-- Result Header -->
<div class="row mb-4">
    <div class="col-12">
        <div class="d-flex justify-content-between align-items-center flex-wrap">
            <div>
                <nav aria-label="breadcrumb">
                    <ol class="breadcrumb">
                        <li class="breadcrumb-item"><a href="{{ app_url }}/dashboard.php">Dashboard</a></li>
                        <li class="breadcrumb-item"><a href="{{ app_url }}/history.php">History</a></li>
                        <li class="breadcrumb-item active">Scan Result</li>
                    </ol>
                </nav>
                <h2 class="mb-0">Scan Result</h2>
            </div>
            <div class="mt-3 mt-md-0">
                <a href="{{ app_url }}/scan.php" class="btn btn-primary me-2">
                    <i class="fas fa-plus me-2"></i>New Scan
                </a>
                <a href="{{ app_url }}/history.php" class="btn btn-outline-secondary">
                    <i class="fas fa-history me-2"></i>History
                </a>
            </div>
        </div>
    </div>
</div>

<div class="row">
    <!-- Left Column: Image & Risk Meter -->
    <div class="col-lg-4 mb-4">
        <!-- Scanned Image -->
        <div class="card mb-4">
            <div class="card-header bg-white py-3">
                <h6 class="mb-0">Scanned Image</h6>
            </div>
            <div class="card-body text-center">
                {% if scan.explanation_path %}
                <div class="position-relative">
                    <img src="{{ app_url }}/{{ scan.image_path }}" class="img-fluid rounded border mb-2" alt="Original lesion" style="max-height: 200px;">
                    <img src="{{ app_url }}/{{ scan.explanation_path }}" class="img-fluid rounded border" alt="Model Attention (Grad-CAM)" style="max-height: 200px;">
                </div>
                <small class="text-muted d-block mt-2"><i class="fas fa-eye me-1"></i>Grad-CAM Model Attention Map</small>
                {% else %}
                <img src="{{ app_url }}/{{ scan.image_path }}" class="img-fluid rounded border" alt="Scanned lesion" style="max-height: 300px;">
                {% endif %}
                
                {% if scan.body_location %}
                <p class="text-muted mt-2 mb-0">
                    <i class="fas fa-map-marker-alt me-1"></i>{{ scan.body_location|replace({'_': ' '})|title }}
                </p>
                {% endif %}
            </div>
        </div>
        
        <!-- Risk Meter -->
        <div class="card">
            <div class="card-header bg-white py-3">
                <h6 class="mb-0">Risk Assessment</h6>
            </div>
            <div class="card-body text-center">
                <div class="position-relative d-inline-block mb-3">
                    <svg class="progress-ring" width="150" height="150">
                        <circle class="progress-ring-circle" 
                                stroke="#e0e0e0" 
                                stroke-width="12" 
                                fill="transparent" 
                                r="60" 
                                cx="75" 
                                cy="75"/>
                        <circle class="progress-ring-circle" 
                                stroke="{% if scan.risk_level == 'High' %}#d32f2f{% elseif scan.risk_level == 'Medium' %}#f57c00{% else %}#388e3c{% endif %}" 
                                stroke-width="12" 
                                fill="transparent" 
                                r="60" 
                                cx="75" 
                                cy="75"
                                stroke-dasharray="377"
                                stroke-dashoffset="{{ 377 - (377 * scan.confidence) }}"
                                stroke-linecap="round"/>
                    </svg>
                    <div class="position-absolute top-50 start-50 translate-middle text-center">
                        <span class="display-6 fw-bold">{{ (scan.confidence * 100)|round(1) }}%</span>
                        <small class="d-block text-muted">Confidence</small>
                    </div>
                </div>
                
                <h4 class="{% if scan.risk_level == 'High' %}risk-high{% elseif scan.risk_level == 'Medium' %}risk-medium{% else %}risk-low{% endif %}">
                    {{ scan.risk_level }} Risk
                </h4>
                <p class="text-muted small">{{ scan.classification }}</p>
            </div>
        </div>
    </div>
    
    <!-- Right Column: Analysis & Details -->
    <div class="col-lg-8">
        <!-- Main Result Card -->
        <div class="card scan-result-card mb-4">
            <div class="card-header bg-white py-3 d-flex justify-content-between align-items-center">
                <h5 class="mb-0"><i class="fas fa-microscope me-2 text-primary"></i>AI Analysis</h5>
                <span class="badge bg-secondary">Model: {{ scan.model_version|default('v1.0.0') }}</span>
            </div>
            <div class="card-body">
                <div class="mb-4">
                    <h6 class="text-muted mb-2">Classification</h6>
                    <h4 class="mb-3">{{ scan.classification }}</h4>
                    <p class="lead">{{ scan.description }}</p>
                </div>
                
                <hr>
                
                <div class="mb-4">
                    <h6 class="text-muted mb-3">
                        <i class="fas fa-lightbulb me-2"></i>Recommendations
                    </h6>
                    <ul class="list-group list-group-flush">
                        {% for recommendation in scan.recommendations %}
                        <li class="list-group-item d-flex align-items-start">
                            <i class="fas fa-check-circle text-primary me-3 mt-1"></i>
                            <span>{{ recommendation }}</span>
                        </li>
                        {% endfor %}
                    </ul>
                </div>
            </div>
        </div>
        
        <!-- Disclaimer -->
        <div class="disclaimer-box">
            <i class="fas fa-exclamation-triangle me-2"></i>
            <strong>Important Disclaimer:</strong> {{ scan.disclaimer|default('This analysis is for informational purposes only and does not constitute medical advice. Always consult a qualified healthcare professional for diagnosis and treatment.') }}
        </div>
        
        <!-- Action Buttons -->
        <div class="card">
            <div class="card-body">
                <h6 class="mb-3">Actions</h6>
                <div class="row">
                    <div class="col-md-4 mb-2">
                        <a href="{{ app_url }}/compare.php?scan1={{ scan.scan_id }}" class="btn btn-outline-primary w-100">
                            <i class="fas fa-exchange-alt me-2"></i>Compare
                        </a>
                    </div>
                    <div class="col-md-4 mb-2">
                        <a href="{{ app_url }}/doctors.php" class="btn btn-outline-info w-100">
                            <i class="fas fa-user-md me-2"></i>Find Doctor
                        </a>
                    </div>
                    <div class="col-md-4 mb-2">
                        <button class="btn btn-outline-secondary w-100" onclick="window.print()">
                            <i class="fas fa-print me-2"></i>Print Report
                        </button>
                    </div>
                </div>
            </div>
        </div>
        
        <!-- Scan Metadata -->
        <div class="card mt-4">
            <div class="card-header bg-white py-3">
                <h6 class="mb-0">Scan Details</h6>
            </div>
            <div class="card-body">
                <div class="row">
                    <div class="col-md-6">
                        <p class="mb-1"><strong>Scan ID:</strong></p>
                        <p class="text-muted font-monospace small">{{ scan.scan_id }}</p>
                    </div>
                    <div class="col-md-6">
                        <p class="mb-1"><strong>Date:</strong></p>
                        <p class="text-muted">{{ scan.created_at|date("F d, Y \\a\\t h:i A") }}</p>
                    </div>
                </div>
                {% if scan.notes %}
                <hr>
                <p class="mb-1"><strong>Your Notes:</strong></p>
                <p class="text-muted">{{ scan.notes }}</p>
                {% endif %}
            </div>
        </div>
    </div>
</div>

<!-- Emergency Notice -->
{% if scan.risk_level == 'High' %}
<div class="alert alert-danger mt-4" role="alert">
    <div class="d-flex align-items-center">
        <i class="fas fa-exclamation-circle fa-2x me-3"></i>
        <div>
            <h5 class="alert-heading mb-1">High Risk Detected</h5>
            <p class="mb-2">This scan indicates a potentially serious condition. Please consult a dermatologist as soon as possible.</p>
            <a href="{{ app_url }}/doctors.php" class="btn btn-danger btn-sm">
                <i class="fas fa-user-md me-2"></i>Find a Dermatologist Now
            </a>
        </div>
    </div>
</div>
{% endif %}

{% endif %}
{% endif %}
{% endblock %}
